#include "stm32f4xx_hal.h"

/* ================= CONFIG ================= */
#define ENS160_ADDR        (0x53 << 1)

/* ENS160 Registers */
#define ENS160_OPMODE      0x10
#define ENS160_AQI         0x21

/* ================= HANDLES ================= */
I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef huart2;

/* ================= PROTOTYPES ================= */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);
static void MX_USART2_UART_Init(void);

/* ================= I2C HELPERS ================= */
void ENS160_Write(uint8_t reg, uint8_t data)
{
  uint8_t buf[2] = {reg, data};
  HAL_I2C_Master_Transmit(&hi2c1, ENS160_ADDR, buf, 2, HAL_MAX_DELAY);
}

uint8_t ENS160_Read(uint8_t reg)
{
  uint8_t data;
  HAL_I2C_Master_Transmit(&hi2c1, ENS160_ADDR, &reg, 1, HAL_MAX_DELAY);
  HAL_I2C_Master_Receive(&hi2c1, ENS160_ADDR, &data, 1, HAL_MAX_DELAY);
  return data;
}

/* ================= MAIN ================= */
int main(void)
{
  char msg[32];
  uint8_t aqi;

  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART2_UART_Init();

  /* ENS160: Set standard operating mode */
  ENS160_Write(ENS160_OPMODE, 0x02);
  HAL_Delay(100);

  while (1)
  {
    aqi = ENS160_Read(ENS160_AQI);

    int len = snprintf(msg, sizeof(msg), "AQI: %d\r\n", aqi);
    HAL_UART_Transmit(&huart2, (uint8_t *)msg, len, HAL_MAX_DELAY);

    HAL_Delay(1000);
  }
}

