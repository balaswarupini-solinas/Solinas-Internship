#include <iostream>
#include <ctime>
#include <string>

#include <GLFW/glfw3.h>

extern "C" {
#include <libavdevice/avdevice.h>
#include <libavformat/avformat.h>
#include <libavcodec/avcodec.h>
#include <libswscale/swscale.h>
#include <libavutil/imgutils.h>
}

#include "imgui.h"
#include "imgui_impl_glfw.h"
#include "imgui_impl_opengl3.h"

// ---------------- Globals ----------------
AVFormatContext* fmt = nullptr;
AVCodecContext* codec = nullptr;
AVFrame* frame = nullptr;
AVFrame* frameRGB = nullptr;
AVPacket* pkt = nullptr;
SwsContext* sws = nullptr;

GLuint videoTex = 0;
int videoStream = -1;
bool cameraOn = false;

// ---------------- Time string ----------------
std::string nowTime() {
    std::time_t t = std::time(nullptr);
    char buf[64];
    std::strftime(buf, sizeof(buf), "%Y-%m-%d  %H:%M:%S", std::localtime(&t));
    return buf;
}

// ---------------- Camera ----------------
bool startCamera() {
    avdevice_register_all();

    const AVInputFormat* inputFmt = av_find_input_format("dshow");
    if (!inputFmt) return false;

    if (avformat_open_input(
            &fmt,
            "video=HP Wide Vision HD Camera",
            inputFmt,
            nullptr) < 0)
        return false;

    avformat_find_stream_info(fmt, nullptr);

    for (unsigned i = 0; i < fmt->nb_streams; i++) {
        if (fmt->streams[i]->codecpar->codec_type == AVMEDIA_TYPE_VIDEO) {
            videoStream = i;
            break;
        }
    }
    if (videoStream == -1) return false;

    const AVCodec* dec =
        avcodec_find_decoder(fmt->streams[videoStream]->codecpar->codec_id);

    codec = avcodec_alloc_context3(dec);
    avcodec_parameters_to_context(codec,
        fmt->streams[videoStream]->codecpar);

    avcodec_open2(codec, dec, nullptr);

    frame = av_frame_alloc();
    frameRGB = av_frame_alloc();
    pkt = av_packet_alloc();

    int w = codec->width;
    int h = codec->height;

    uint8_t* buffer =static_cast<uint8_t*>(av_malloc(
        av_image_get_buffer_size(AV_PIX_FMT_RGB24, w, h, 1)));

    av_image_fill_arrays(frameRGB->data, frameRGB->linesize,
        buffer, AV_PIX_FMT_RGB24, w, h, 1);

    sws = sws_getContext(
        w, h, codec->pix_fmt,
        w, h, AV_PIX_FMT_RGB24,
        SWS_BILINEAR, nullptr, nullptr, nullptr);

    glGenTextures(1, &videoTex);
    glBindTexture(GL_TEXTURE_2D, videoTex);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);

    cameraOn = true;
    return true;
}

void stopCamera() {
    cameraOn = false;
    if (videoTex) glDeleteTextures(1, &videoTex);
    if (sws) sws_freeContext(sws);
    if (frame) av_frame_free(&frame);
    if (frameRGB) av_frame_free(&frameRGB);
    if (pkt) av_packet_free(&pkt);
    if (codec) avcodec_free_context(&codec);
    if (fmt) avformat_close_input(&fmt);
}

bool updateFrame() {
    if (!cameraOn) return false;

    if (av_read_frame(fmt, pkt) >= 0) {
        if (pkt->stream_index == videoStream) {
            avcodec_send_packet(codec, pkt);
            if (avcodec_receive_frame(codec, frame) == 0) {
                sws_scale(
                    sws,
                    frame->data, frame->linesize,
                    0, codec->height,
                    frameRGB->data, frameRGB->linesize);

                glBindTexture(GL_TEXTURE_2D, videoTex);
                glTexImage2D(
                    GL_TEXTURE_2D, 0, GL_RGB,
                    codec->width, codec->height,
                    0, GL_RGB, GL_UNSIGNED_BYTE,
                    frameRGB->data[0]);

                av_packet_unref(pkt);
                return true;
            }
        }
        av_packet_unref(pkt);
    }
    return false;
}

// ---------------- Main ----------------
int main() {
    glfwInit();
    GLFWwindow* window =
        glfwCreateWindow(1280, 800, "Camera App", nullptr, nullptr);
    glfwMakeContextCurrent(window);

    IMGUI_CHECKVERSION();
    ImGui::CreateContext();
    ImGui_ImplGlfw_InitForOpenGL(window, true);
    ImGui_ImplOpenGL3_Init("#version 130");

    while (!glfwWindowShouldClose(window)) {
        glfwPollEvents();
        ImGui_ImplOpenGL3_NewFrame();
        ImGui_ImplGlfw_NewFrame();
        ImGui::NewFrame();

        ImGui::Begin("Main");

        ImGui::SetCursorPosX(
            (ImGui::GetWindowWidth() - 200) * 0.5f);

        if (!cameraOn) {
            if (ImGui::Button("START CAMERA", ImVec2(200, 40)))
                startCamera();
        } else {
            if (ImGui::Button("STOP CAMERA", ImVec2(200, 40)))
                stopCamera();
        }

        ImGui::Separator();

        if (cameraOn && updateFrame()) {
            ImGui::Image(
                (ImTextureID)(intptr_t)videoTex,
                ImVec2(640, 480));
            ImGui::Text("%s", nowTime().c_str());
        } else {
            ImGui::TextDisabled("No video signal");
        }

        ImGui::End();

        ImGui::Render();
        int w, h;
        glfwGetFramebufferSize(window, &w, &h);
        glViewport(0, 0, w, h);
        glClear(GL_COLOR_BUFFER_BIT);
        ImGui_ImplOpenGL3_RenderDrawData(ImGui::GetDrawData());
        glfwSwapBuffers(window);
    }

    stopCamera();
    ImGui_ImplOpenGL3_Shutdown();
    ImGui_ImplGlfw_Shutdown();
    ImGui::DestroyContext();
    glfwTerminate();
    return 0;
}
